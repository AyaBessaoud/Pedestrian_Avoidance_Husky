<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- RPlidar Link -->
  <link name="rplidar_link">
    <visual>
      <geometry>
        <mesh filename="package://clearpath_sensors_description/meshes/rplidar.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <origin xyz="0.05 0 0.015" rpy="1.57 0.0 0.0"/>
      <material name="clearpath_black"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://clearpath_sensors_description/meshes/rplidar.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <origin xyz="0.05 0 0.015" rpy="1.57 0.0 0.0"/>
    </collision>
  </link>

  <joint name="rplidar_joint" type="fixed">
    <parent link="top_plate_rear_mount"/>
    <child link="rplidar_link"/>
    <origin xyz="0.057 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <gazebo reference="rplidar_link">
    <sensor name="lidar2d_0" type="gpu_lidar">
      <ignition_frame_id>rplidar_link</ignition_frame_id>
      <topic>/a200_0846/sensors/lidar2d_0/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>400</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>